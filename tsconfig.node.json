{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "CommonJS",
        "moduleResolution": "node",
        "strict": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "outDir": "out"
    },
    "include": ["electron.vite.config.ts", "electron/**/*.ts"]
}
